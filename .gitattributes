# ============================================================
# .gitattributes — EduLearn line-ending normalization
# Ensures consistent LF line endings in the repo regardless
# of the OS the file was created on (Windows / Mac / Linux).
# ============================================================

# Default: normalize all text files to LF in the repo
*           text=auto eol=lf

# Explicitly LF for source code
*.jsx       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.xml       text eol=lf
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf

# Windows-specific files keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files — no line ending conversion at all
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.dll       binary
*.exe       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
