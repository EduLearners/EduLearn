{
    //It isuse filters messages by their importance (Severity)
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EduLearnDb;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true"
    },

    "Jwt": {
        "Issuer": "EduLearn",//Who created the token
        "Audience": "EduLearn-Client",//Who tocken is for
        "Key": "ThisIsA32CharSecretKeyForEduLearn!",//Secret key
        "ExpiryInMinutes": 60
    }
}
